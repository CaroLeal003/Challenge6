    "This is a free play mode\nExplore your creativity and create something amazing!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " هذا وضع اللعب الحر\n اكتشف إبداعك وابتكر شيئًا رائعًا"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este es un modo libre\nExplora tu creatividad y crea algo asombroso!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est un mode de jeu gratuit \nExplore ton créativité et crée quelque chose d’incroyable!"
