    },
    "Now we're going to play a little game!\nPress the correct button to fill in the bar" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "!الآن سنلعب لعبة صغيرة\nاضغط على الزر الصحيح لملء الشريط"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora vamos a jugar!\nPresiona el botón correcto para llenar la barra"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenant nous allons jouer à un petit jeu\nAppuyer sur le bon bouton pour remplir la barre"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È il momento di un gioco!\nPremi il tasto giusto per riempire la barra"
          }
        }
      }
    },
